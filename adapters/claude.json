{
  "platform": "claude",
  "display_name": "Claude Code",
  "output": "platforms/claude/pstack",
  "include": ["skills", "agents", "LICENSE"],
  "manifest_dir": ".claude-plugin",
  "config_path": "~/.pstack/claude-models.md",
  "invocation_prefix": "/pstack:",
  "copy_agents": true,
  "model_replacements": {
    "`claude-opus-4-8-thinking-xhigh`, `gpt-5.5-high-fast`, `grok-4.5-fast-xhigh`": "`opus`, `sonnet`, `haiku`",
    "claude-opus-4-8-thinking-xhigh, gpt-5.5-high-fast, grok-4.5-fast-xhigh": "opus, sonnet, haiku",
    "claude-opus-4-8-thinking-xhigh": "opus",
    "claude-fable-5-thinking-max": "opus",
    "gpt-5.5-high-fast": "sonnet",
    "grok-4.5-fast-xhigh": "sonnet"
  },
  "text_replacements": {
    "~/.cursor/skills/": "~/.claude/skills/",
    ".cursor/skills/": ".claude/skills/",
    "~/.cursor/plugins/": "~/.claude/plugins/",
    "~/.cursor/projects/*/": "~/.claude/projects/*/",
    "Cursor's built-in `create-skill` skill": "Claude Code's skill-authoring workflow",
    "Cursor's built-in **create-skill** skill": "Claude Code's **skill-authoring workflow**",
    "Cursor's built-in **babysit** skill": "a bounded PR-check monitoring loop using available GitHub tools",
    "Cursor's `/loop` command": "a bounded polling loop in the current Claude Code session",
    "Cursor restart": "Claude Code restart",
    "restart Cursor": "restart Claude Code",
    "from the Cursor environment": "from the Claude Code environment",
    "Cursor also exposes": "Claude Code also exposes",
    "in the user's Cursor model picker": "in Claude Code's supported model list",
    "Cursor model picker": "Claude Code supported model list",
    "Cursor Slack actions": "available Slack MCP actions",
    "point cursor at": "point Claude Code at",
    "point Cursor at": "point Claude Code at",
    "cursor location": "current editor location",
    "Cursor's built-in": "Claude Code's built-in",
    "Cursor": "Claude Code",
    "cursor": "Claude Code",
    "AskQuestion": "AskUserQuestion",
    "`Task`": "`Agent`",
    "Task subagent": "Agent subagent",
    "Task calls": "Agent calls",
    "Task call": "Agent call",
    "Task response body": "Agent result",
    "Task prompts": "Agent prompts",
    "generalPurpose": "general-purpose",
    "`readonly: true`": "an explicit no-write instruction in the Agent prompt",
    "`readonly: false`": "normal inherited tool access",
    "readonly strips MCP": "an overly restrictive tool allowlist removes MCP access",
    "Readonly/Ask mode strips MCPs": "an overly restrictive tool allowlist removes MCP access",
    "readonly/Ask mode": "an overly restrictive tool allowlist",
    "readonly judge subagent": "read-only judge subagent",
    "readonly/Ask": "restrictive tool allowlist",
    "one `Task` call": "one `Agent` call",
    "three `Task` calls": "three parallel `Agent` calls",
    "Multiple `Task` calls": "Multiple `Agent` calls",
    "Every `Task` call": "Every `Agent` call",
    "`subagent_type: generalPurpose`": "the built-in `general-purpose` agent",
    "`subagent_type`: `generalPurpose`": "agent type: `general-purpose`",
    "subagent_type": "agent type",
    "run_in_background: true": "run independent agents in parallel before waiting",
    "agent mode (readonly strips MCP)": "normal inherited tool access",
    "agent mode (`readonly: false`)": "normal inherited tool access",
    "agent mode (readonly: false)": "normal inherited tool access",
    "agent mode. **Do not use readonly/Ask mode.** It strips MCP access": "normal inherited tool access; explicitly prohibit writes in the Agent prompt when the work is read-only",
    "the `cursor-team-kit` plugin": "equivalent Claude Code verification tooling",
    "`cursor-team-kit`": "equivalent Claude Code verification tooling",
    "the `deslop` skill": "the bundled `unslop` skill",
    "`/deslop`": "`/pstack:unslop`",
    "`/babysit`": "a bounded PR-check monitoring loop",
    "`/create-skill`": "Claude Code's skill-authoring workflow",
    "`create-skill`": "skill-authoring workflow",
    "create-skill": "skill-authoring workflow",
    "`/loop`": "a bounded polling loop",
    "/loop": "a bounded polling loop"
  },
  "forbidden_patterns": [
    "~/.cursor",
    "~/.Claude Code",
    ".cursor/skills",
    "AskQuestion",
    "generalPurpose",
    "grok-4.5",
    "gpt-5.5",
    "claude-opus-4-8",
    "claude-fable-5",
    "Cursor's `/loop`",
    "Task tool's error message",
    "`readonly`:"
  ]
}
